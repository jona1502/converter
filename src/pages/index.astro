---
import BaseLayout from '../layouts/BaseLayout.astro';
import { availableToolsByCategory } from '../data/tools';

const steps = [
  { title: 'Dateien wählen', text: 'Dateien auswählen oder in den Bereich ziehen.' },
  { title: 'Optionen einstellen', text: 'Zielformat, Qualität oder Größe festlegen.' },
  { title: 'Verarbeiten', text: 'Die Umwandlung läuft im Browser auf Ihrem Gerät.' },
  { title: 'Herunterladen', text: 'Ergebnisse einzeln speichern.' },
];
---
<BaseLayout
  title="Dateien im Browser bearbeiten"
  description="Werkzeuge für alltägliche Dateiaufgaben. Die Verarbeitung läuft im Browser auf Ihrem Gerät, Dateien werden nicht hochgeladen."
>
  <div class="page-container">
    <section aria-labelledby="titel">
      <h1 id="titel" class="page-title">Dateien direkt im Browser bearbeiten</h1>
      <p class="page-lead">
        Werkzeuge für alltägliche Dateiaufgaben. Die Verarbeitung läuft im Browser auf Ihrem Gerät –
        Ihre Dateien werden dabei nicht hochgeladen.
      </p>
      <p class="mt-4">
        <a href="/lokale-verarbeitung" class="link">Mehr zur lokalen Verarbeitung</a>
      </p>
    </section>

    <section class="page-section" aria-labelledby="werkzeuge">
      <h2 id="werkzeuge" class="section-title">Werkzeuge</h2>
      {
        availableToolsByCategory.length === 0 ? (
          <p class="notice notice-info mt-6 max-w-2xl">
            Derzeit ist noch kein Werkzeug freigeschaltet. Verfügbare Werkzeuge erscheinen an dieser Stelle.
          </p>
        ) : (
          availableToolsByCategory.map(({ category, tools }) => (
            <div class="mt-6">
              <h3 class="text-sm font-semibold uppercase tracking-wide text-muted">{category.title}</h3>
              <ul class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {tools.map((tool) => (
                  <li class="flex">
                    <a href={tool.href} class="card-link flex w-full flex-col gap-2">
                      <span class="card-title">{tool.title}</span>
                      <span class="text-muted">{tool.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        )
      }
    </section>

    {availableToolsByCategory.length > 0 && (
    <section class="page-section" aria-labelledby="ablauf">
      <h2 id="ablauf" class="section-title">So funktioniert es</h2>
      <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step, index) => (
            <li class="card flex gap-4">
              <span
                class="flex size-8 shrink-0 items-center justify-center rounded-full bg-accent-soft font-semibold text-accent"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <div>
                <p class="font-semibold">{step.title}</p>
                <p class="mt-1 text-sm text-muted">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
    )}
  </div>
</BaseLayout>
