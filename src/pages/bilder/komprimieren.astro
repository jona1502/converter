---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageCompressor from '../../components/tools/ImageCompressor';
---
<BaseLayout title="Bilder komprimieren" description="Bilder auf dem Server komprimieren, Qualität und maximale Kantenlänge wählen und tatsächliche Ergebnisgrößen vergleichen.">
  <div class="page-container">
    <h1 class="page-title">Bilder komprimieren</h1>
    <p class="page-lead">Wählen Sie Format, Qualität und bei Bedarf kleinere Abmessungen. Vergleichen Sie anschließend die tatsächlichen Dateigrößen; eine kleinere Datei ist nicht garantiert.</p>
    <div class="page-section"><ImageCompressor client:load /></div>
  </div>
</BaseLayout>
