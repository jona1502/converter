---
import ToolPage from '../../components/site/ToolPage.astro';
import ImageConverter from '../../components/tools/ImageConverter';
import { INPUT_FORMATS, formatList } from '../../components/tools/formats';

const formats = formatList(INPUT_FORMATS);
---
<ToolPage
  toolId="bilder-konvertieren"
  description={`Bilder (${formats}) auf dem Server in JPEG, PNG, WebP, BMP oder ICO umwandeln. Verarbeitung auf dem Server nach ausdrücklichem Start.`}
>
  <ImageConverter client:load />
</ToolPage>
