---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageConverter from '../../components/tools/ImageConverter';
import { INPUT_FORMATS, formatList } from '../../components/tools/formats';

const formats = formatList(INPUT_FORMATS);
---
<BaseLayout
  title="Bilder konvertieren"
  description={`Bilder (${formats}) im Browser in JPEG, PNG, WebP, BMP oder ICO umwandeln. Verarbeitung auf Ihrem Gerät ohne Upload.`}
>
  <div class="page-container">
    <h1 class="page-title">Bilder konvertieren</h1>
    <p class="page-lead">
      Wandeln Sie Bilder in ein anderes Format um – etwa PNG in WebP oder WebP in JPEG. Die Umwandlung
      läuft im Browser auf Ihrem Gerät; die Dateien werden nicht hochgeladen.
    </p>

    <div class="page-section">
      {/* client:load: Das Werkzeug ist der Hauptinhalt der Seite und soll sofort bedienbar sein. */}
      <ImageConverter client:load />
    </div>

  </div>
</BaseLayout>
