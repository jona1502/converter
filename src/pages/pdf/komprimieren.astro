---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PdfCompressor from '../../components/tools/PdfCompressor';
---
<BaseLayout title="PDF komprimieren" description="PDF auf dem Server in drei Qualitätsstufen komprimieren. Tatsächliche Größen in KB und MB vergleichen, nach ausdrücklichem Start.">
  <div class="page-container">
    <h1 class="page-title">PDF komprimieren</h1>
    <p class="page-lead">Vergleichen Sie drei berechnete Varianten Ihrer PDF. Die Größen entstehen aus Ihrer Datei und werden nach der Verarbeitung exakt gemessen.</p>
    <div class="page-section"><PdfCompressor client:load /></div>
  </div>
</BaseLayout>
