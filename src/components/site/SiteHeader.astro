---
import { availableToolsByAction } from '../../data/tools';
interface Props { siteName: string }
const { siteName } = Astro.props;
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<header class="site-header">
  <div class="page-container header-inner">
    <a href="/" class="brand" aria-current={current === '/' ? 'page' : undefined}>
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span>{siteName}</span>
    </a>
    {/* Nur mit JavaScript sichtbar; ohne Skript steht die Navigation offen unter der Marke. */}
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="hauptnavigation" hidden>
      <span>Menü</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <nav id="hauptnavigation" class="main-nav" aria-label="Hauptnavigation">
      <ul class="nav-groups">
        {availableToolsByAction.map(({ action, tools }) => (
          <li class="nav-group">
            {/* Beschriftung statt Button: ohne JavaScript und in der mobilen Liste. */}
            <span class="nav-label">{action.title}</span>
            {/* Eigener Name, damit die Menü-Buttons nicht mit den Aktionsbuttons der Werkzeuge ("Konvertieren") verwechselt werden. */}
            <button type="button" class="nav-trigger" aria-label={`${action.title}-Menü`} aria-expanded="false" aria-controls={`menue-${action.id}`}>
              {action.title}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <ul class="nav-panel" id={`menue-${action.id}`}>
              {tools.map(tool => <li><a href={tool.href} aria-current={current === tool.href ? 'page' : undefined}>{tool.title}</a></li>)}
            </ul>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Wie die Muhr-Kopfzeile: schwarz, Haarlinie unten, Wortmarke und Navigation in gesperrten Großbuchstaben. */
  .site-header { position: relative; z-index: 40; border-bottom: 1px solid var(--color-border); background: var(--color-header-solid); }
  .header-inner { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .5rem; padding-top: .75rem; padding-bottom: .75rem; }
  .brand { display: inline-flex; align-items: center; gap: .6rem; min-height: 2.75rem; margin-right: auto; color: var(--color-ink); text-decoration: none; font-family: var(--font-display); font-size: 1.375rem; font-weight: 700; letter-spacing: .06em; line-height: 1; text-transform: uppercase; white-space: nowrap; }
  .brand img { flex: none; }
  .brand:hover { color: var(--color-ink); }
  .nav-groups { display: flex; flex-wrap: wrap; gap: .25rem; margin: 0; padding: 0; list-style: none; }
  .nav-group { position: relative; }
  .nav-panel { margin: 0; padding: 0; list-style: none; }
  .nav-label { display: block; padding: .5rem .75rem 0; color: var(--color-muted); font-size: .6875rem; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; }
  .main-nav .nav-trigger { display: none; }
  /* Einträge gedämpft; Überfahren und aktive Seite in Weiß, aktive Seite zusätzlich mit Linie unten. */
  .nav-panel a, .nav-trigger, .menu-toggle { display: flex; align-items: center; min-height: 2.75rem; padding: .625rem .75rem; color: var(--color-muted); font-size: .75rem; line-height: 1.4; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; text-decoration: none; overflow-wrap: anywhere; }
  .nav-trigger, .menu-toggle { gap: .4rem; border: 0; background: transparent; cursor: pointer; }
  .nav-panel a:hover, .nav-trigger:hover, .menu-toggle:hover { color: var(--color-ink); }
  .nav-trigger[aria-expanded="true"], .menu-toggle[aria-expanded="true"] { color: var(--color-ink); }
  .nav-panel a[aria-current] { color: var(--color-ink); font-weight: 600; box-shadow: inset 2px 0 0 var(--color-ink); }
  .nav-trigger svg, .menu-toggle svg { color: currentColor; }
  .nav-trigger[aria-expanded="true"] svg, .menu-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  @media (prefers-reduced-motion: no-preference) {
    .nav-trigger svg, .menu-toggle svg { transition: transform .25s ease; }
  }
  .menu-toggle[hidden] { display: none; }

  /* Schmal: Navigation als einfache Liste unter der Kopfzeile, mit Skript hinter dem Menü-Button. */
  @media (max-width: 767.98px) {
    .main-nav { order: 3; width: 100%; padding-bottom: .5rem; }
    .main-nav[data-js]:not([data-open]) { display: none; }
    .nav-groups { flex-direction: column; gap: .5rem; }
  }

  @media (min-width: 768px) {
    .header-inner { flex-wrap: nowrap; gap: .5rem; }
    .brand { margin-right: 1.5rem; }
    .main-nav { margin-right: auto; }
    .nav-groups { flex-wrap: nowrap; }
    .menu-toggle, .menu-toggle[hidden] { display: none; }
    /* Mit Skript: Dropdown als schwarze Fläche mit Haarlinie, eckig, ohne Schatten. */
    .main-nav[data-js] .nav-label { display: none; }
    .main-nav[data-js] .nav-trigger { display: flex; }
    .main-nav[data-js] .nav-panel { display: none; position: absolute; left: 0; top: calc(100% + .75rem); width: max-content; min-width: 14rem; max-width: min(22rem, calc(100vw - 2rem)); padding: .5rem 0; border: 1px solid var(--color-border-strong); background: var(--color-canvas); }
    .main-nav[data-js] .nav-panel a { padding-left: 1rem; padding-right: 1rem; }
    .main-nav[data-js] .nav-panel a:hover { background: var(--color-fill); }
    .main-nav[data-js] .nav-group[data-open] .nav-panel { display: block; }
    /* Ohne Skript: Gruppen nebeneinander, Beschriftung über den Links. */
    .main-nav:not([data-js]) .nav-groups { gap: 1.5rem; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.main-nav');
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  if (nav && menuToggle) {
    nav.dataset.js = '';
    menuToggle.hidden = false;
    const groups = [...nav.querySelectorAll<HTMLElement>('.nav-group')];
    const triggerOf = (group: HTMLElement) => group.querySelector<HTMLButtonElement>('.nav-trigger')!;
    const linksOf = (group: HTMLElement) => [...group.querySelectorAll<HTMLAnchorElement>('.nav-panel a')];
    const isOpen = (element: HTMLElement) => 'open' in element.dataset;
    const setGroup = (group: HTMLElement, open: boolean) => {
      if (open) group.dataset.open = ''; else delete group.dataset.open;
      triggerOf(group).setAttribute('aria-expanded', String(open));
    };
    // Immer höchstens ein Dropdown offen.
    const openGroup = (group: HTMLElement | null) => groups.forEach(other => setGroup(other, other === group));
    const setMenu = (open: boolean) => {
      if (open) nav.dataset.open = ''; else delete nav.dataset.open;
      menuToggle.setAttribute('aria-expanded', String(open));
    };

    menuToggle.addEventListener('click', () => setMenu(!isOpen(nav)));
    groups.forEach(group => {
      const trigger = triggerOf(group);
      trigger.addEventListener('click', () => openGroup(isOpen(group) ? null : group));
      group.addEventListener('keydown', event => {
        const links = linksOf(group);
        const index = links.indexOf(document.activeElement as HTMLAnchorElement);
        if (event.target === trigger && event.key === 'ArrowDown') {
          event.preventDefault();
          openGroup(group);
          links[0]?.focus();
        } else if (index >= 0 && ['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
          event.preventDefault();
          const next = event.key === 'Home' ? 0 : event.key === 'End' ? links.length - 1
            : (index + (event.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length;
          links[next]!.focus();
        }
      });
      group.addEventListener('focusout', event => {
        // Nullziel (z. B. WebKit nach Klick auf einen Link) darf den Klick nicht vorzeitig verbergen.
        if (event.relatedTarget && !group.contains(event.relatedTarget as Node)) setGroup(group, false);
      });
    });
    document.addEventListener('keydown', event => {
      if (event.key !== 'Escape') return;
      const open = groups.find(isOpen);
      if (open) {
        setGroup(open, false);
        triggerOf(open).focus();
      } else if (isOpen(nav) && menuToggle.offsetParent !== null) {
        setMenu(false);
        menuToggle.focus();
      }
    });
    document.addEventListener('click', event => {
      const target = event.target as Node;
      groups.forEach(group => { if (!group.contains(target)) setGroup(group, false); });
      if (isOpen(nav) && !nav.contains(target) && !menuToggle.contains(target)) setMenu(false);
    });
  }
</script>
