---
import { availableToolsByCategory } from '../../data/tools';
interface Props { siteName: string }
const { siteName } = Astro.props;
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-current={current === '/' ? 'page' : undefined}>
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span>{siteName}</span>
    </a>
    <details class="tool-picker" open>
      <summary role="button" aria-label="Werkzeuge auswählen" aria-controls="werkzeugnavigation">
        Werkzeuge
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </summary>
      <nav id="werkzeugnavigation" aria-label="Hauptnavigation" class="tool-navigation">
        <a class="catalog-link" href="/" aria-current={current === '/' ? 'page' : undefined}>Alle Werkzeuge</a>
        {availableToolsByCategory.map(({ category, tools }) => (
          <div class="nav-category">
            <h2>{category.title}</h2>
            <ul>
              {tools.map(tool => <li><a href={tool.href} aria-current={current === tool.href ? 'page' : undefined}>{tool.title}</a></li>)}
            </ul>
          </div>
        ))}
        <a class="information-link" href="/lokale-verarbeitung" aria-current={current === '/lokale-verarbeitung' ? 'page' : undefined}>Dateiverarbeitung</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { z-index: 40; border-bottom: 1px solid var(--color-border); background: var(--color-surface); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: .75rem 1rem; }
  .brand { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; color: var(--color-ink); text-decoration: none; font-size: 1.0625rem; font-weight: 650; letter-spacing: -.035em; white-space: nowrap; }
  .brand img { flex: none; border-radius: .5rem; }
  .tool-picker { position: relative; min-width: 0; }
  summary { display: flex; align-items: center; justify-content: space-between; gap: .25rem; min-height: 2.75rem; padding: .5rem .65rem; border: 1px solid var(--color-border-control); border-radius: var(--radius-control); font-size: .875rem; font-weight: 600; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--color-surface-muted); }
  details[open] summary svg { transform: rotate(180deg); }
  .tool-navigation { position: absolute; right: 0; top: calc(100% + .5rem); width: min(22rem, calc(100vw - 2rem)); padding: .75rem; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface); box-shadow: var(--shadow-panel); }
  .tool-navigation a { display: flex; align-items: center; min-height: 2.75rem; padding: .625rem .75rem; border-radius: var(--radius-control); color: var(--color-ink); font-size: .875rem; line-height: 1.4; font-weight: 550; text-decoration: none; overflow-wrap: anywhere; }
  .tool-navigation a:hover { background: var(--color-surface-muted); }
  .tool-navigation a[aria-current] { color: var(--color-accent); background: var(--color-accent-soft); font-weight: 650; }
  .nav-category { margin-top: 1.25rem; }
  .nav-category h2 { padding: 0 .75rem; margin: 0 0 .25rem; color: var(--color-muted); font-size: .875rem; font-weight: 500; }
  .nav-category ul { margin: 0; padding: 0; list-style: none; }
  .tool-navigation .information-link { margin-top: 1.25rem; border-top: 1px solid var(--color-border); border-radius: 0; color: var(--color-muted); }
  @media (min-width: 1024px) {
    .site-header { position: fixed; inset: 0 auto 0 0; width: 14rem; height: 100dvh; overflow-y: auto; border-bottom: 0; border-right: 1px solid var(--color-border); }
    .header-inner { display: block; padding: 1.5rem .75rem; }
    .brand { margin: 0 .75rem 2rem; }
    summary { display: none; }
    .tool-navigation { position: static; width: auto; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
    .nav-category { margin-top: 1.5rem; }
    .tool-navigation .information-link { margin-top: 2rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.tool-picker').forEach(picker => {
    const trigger = picker.querySelector('summary')!;
    const desktop = matchMedia('(min-width: 1024px)');
    const setOpen = (open: boolean) => {
      picker.open = open;
      trigger.setAttribute('aria-expanded', String(open));
    };
    // Native Details bleiben ohne JavaScript geöffnet und damit überall auffindbar.
    setOpen(desktop.matches);
    desktop.addEventListener('change', () => {
      const focusInside = picker.contains(document.activeElement);
      setOpen(desktop.matches);
      if (!desktop.matches && focusInside) trigger.focus();
    });
    picker.addEventListener('toggle', () => trigger.setAttribute('aria-expanded', String(picker.open)));
    picker.addEventListener('keydown', event => {
      if (event.key !== 'Escape' || desktop.matches || !picker.open) return;
      event.preventDefault();
      setOpen(false);
      trigger.focus();
    });
    picker.addEventListener('focusout', event => {
      // WebKit fokussiert angeklickte Links teils nicht. Ein Nullziel darf ihren Klick nicht vorzeitig verbergen.
      if (!desktop.matches && event.relatedTarget && !picker.contains(event.relatedTarget as Node)) setOpen(false);
    });
    document.addEventListener('click', event => {
      if (!desktop.matches && !picker.contains(event.target as Node)) setOpen(false);
    });
  });
</script>
