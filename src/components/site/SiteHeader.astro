---
import { availableTools, TOOL_CATEGORIES, type ToolOperation } from '../../data/tools';
interface Props { siteName: string }
const { siteName } = Astro.props;
const normalize = (path: string) => path.length > 1 ? path.replace(/\/+$/, '') : path;
const current = normalize(Astro.url.pathname);
const operations: { id: ToolOperation; label: string }[] = [
  { id: 'konvertieren', label: 'Konvertieren' },
  { id: 'komprimieren', label: 'Komprimieren' },
  { id: 'skalieren', label: 'Skalieren' },
];
---
<header class="site-header">
  <div class="page-container header-inner">
    <a href="/" class="brand" aria-current={current === '/' ? 'page' : undefined}>
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span>{siteName}</span>
    </a>
    <nav aria-label="Hauptnavigation" class="tool-navigation">
      <ul class="nav-groups">
        {operations.map(operation => {
          const tools = availableTools.filter(tool => tool.operation === operation.id)
            .sort((a, b) => TOOL_CATEGORIES.findIndex(category => category.id === a.category) - TOOL_CATEGORIES.findIndex(category => category.id === b.category));
          if (!tools.length) return null;
          const active = tools.some(tool => tool.href === current);
          return <li>
            <details class="nav-dropdown" data-active={active || undefined}>
              <summary>{operation.label}<svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
              <ul class="nav-panel">
                {tools.map(tool => <li><a href={tool.href} aria-current={current === tool.href ? 'page' : undefined}>
                  <span class="nav-tool-title">{tool.title}</span>
                  <span class="nav-tool-description">{tool.description}</span>
                </a></li>)}
              </ul>
            </details>
          </li>;
        })}
        <li class="nav-info"><a href="/lokale-verarbeitung" aria-label="Lokale Verarbeitung" aria-current={current === '/lokale-verarbeitung' ? 'page' : undefined}>Info</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Schlanke, transluzente Leiste; ohne backdrop-filter-Unterstützung deckend. */
  .site-header { position: sticky; top: 0; z-index: 40; border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent); background: var(--color-header-solid); }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header { background: var(--color-header); -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px); }
  }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.25rem; }
  .brand { display: inline-flex; align-items: center; gap: .55rem; min-height: 2.75rem; color: var(--color-ink); text-decoration: none; font-family: var(--font-display); font-size: 1.1875rem; font-weight: 600; letter-spacing: -.03em; white-space: nowrap; }
  .brand img { flex: none; border-radius: .45rem; }
  .brand:hover { color: var(--color-ink); }
  .tool-navigation { position: relative; }
  .nav-groups { display: flex; align-items: center; gap: .15rem; margin: 0; padding: 0; list-style: none; }
  .nav-dropdown { position: relative; }
  summary, .nav-info a { display: flex; align-items: center; justify-content: center; gap: .3rem; min-height: 2.75rem; padding: .5rem .8rem; border-radius: 980px; color: var(--color-ink); opacity: 1; font-size: .875rem; font-weight: 400; letter-spacing: -.01em; text-decoration: none; cursor: pointer; list-style: none; transition: background-color .2s ease, color .2s ease; }
  summary::-webkit-details-marker { display: none; }
  summary svg { color: var(--color-muted); transition: transform .25s ease; }
  summary:hover, .nav-info a:hover, details[open] summary { background: color-mix(in srgb, var(--color-ink) 7%, transparent); }
  details[data-active] summary, .nav-info a[aria-current] { color: var(--color-accent); font-weight: 600; }
  details[open] summary svg { transform: rotate(180deg); }
  .nav-panel { position: absolute; z-index: 30; top: calc(100% + .45rem); left: 0; width: 20rem; padding: .45rem; margin: 0; border: 1px solid var(--color-border); border-radius: 1.125rem; background: var(--color-surface); box-shadow: var(--shadow-panel); list-style: none; }
  .nav-groups > li:nth-last-child(2) .nav-panel { left: auto; right: 0; }
  /* Unsichtbare Brücke über den Abstand, damit das Menü beim Überfahren mit der Maus offen bleibt. */
  .nav-panel::before { content: ""; position: absolute; left: 0; right: 0; top: -.6rem; height: .6rem; }
  .nav-panel a { display: flex; flex-direction: column; gap: .2rem; padding: .75rem .9rem; border-radius: .75rem; text-decoration: none; color: var(--color-ink); transition: background-color .2s ease; }
  .nav-panel a:hover, .nav-panel a:focus-visible { background: var(--color-surface-muted); }
  .nav-panel a[aria-current] { background: var(--color-accent-soft); }
  .nav-panel a[aria-current] .nav-tool-title { color: var(--color-accent); }
  .nav-tool-title { font-size: .9375rem; font-weight: 600; letter-spacing: -.015em; }
  .nav-tool-description { font-size: .8125rem; line-height: 1.4; letter-spacing: -.005em; color: var(--color-muted); }
  .nav-info { margin-left: .25rem; }
  @media (prefers-reduced-motion: no-preference) {
    details[open] .nav-panel { animation: nav-panel-in .18s ease-out; }
  }
  @keyframes nav-panel-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  @media (max-width: 767px) {
    .header-inner { flex-wrap: wrap; gap: 0; padding-top: .25rem; padding-bottom: .25rem; }
    .tool-navigation { width: 100%; }
    .nav-groups { flex-wrap: wrap; justify-content: space-between; gap: 0; }
    .nav-dropdown { position: static; }
    summary, .nav-info a { gap: .1rem; padding: .4rem .2rem; font-size: .75rem; letter-spacing: -.01em; }
    summary svg { width: 10px; height: 10px; }
    .nav-info { margin-left: 0; }
    .nav-panel, .nav-groups > li:nth-last-child(2) .nav-panel { left: 0; right: 0; width: 100%; top: calc(100% + .25rem); }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.tool-navigation').forEach(nav => {
    const menus = [...nav.querySelectorAll<HTMLDetailsElement>('.nav-dropdown')];
    const closeOthers = (except?: HTMLDetailsElement) => menus.forEach(menu => { if (menu !== except) menu.open = false; });
    menus.forEach(menu => {
      const trigger = menu.querySelector('summary')!;
      let openedByHover = false;
      menu.addEventListener('pointerenter', event => {
        if (event.pointerType !== 'mouse' || !matchMedia('(hover: hover)').matches) return;
        closeOthers(menu);
        openedByHover = !menu.open;
        menu.open = true;
      });
      menu.addEventListener('pointerleave', event => {
        if (event.pointerType === 'mouse' && !menu.contains(document.activeElement)) menu.open = false;
      });
      trigger.addEventListener('click', event => {
        // A click following hover should keep the revealed links available.
        if (event.detail > 0 && openedByHover && menu.open) event.preventDefault();
        openedByHover = false;
        closeOthers(menu);
      });
      menu.addEventListener('focusout', event => {
        if (!menu.contains(event.relatedTarget as Node | null)) menu.open = false;
      });
      menu.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        event.preventDefault();
        menu.open = false;
        trigger.focus();
      });
    });
    document.addEventListener('click', event => {
      if (!nav.contains(event.target as Node)) closeOthers();
    });
  });
</script>
