---
interface Props { siteName: string }
const { siteName } = Astro.props;
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<footer class="site-footer">
  <div class="page-container footer-inner">
    <nav aria-label="Fußzeile">
      <a href="/lokale-verarbeitung" class="footer-link" aria-current={current === '/lokale-verarbeitung' ? 'page' : undefined}>Dateiverarbeitung</a>
    </nav>
    <p>{siteName}</p>
  </div>
</footer>

<style>
  .site-footer { margin-top: auto; border-top: 1px solid var(--color-border); background: var(--color-canvas); color: var(--color-muted); font-size: .6875rem; font-weight: 500; letter-spacing: .16em; line-height: 1.55; text-transform: uppercase; }
  .footer-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .25rem 1.5rem; padding-top: 1rem; padding-bottom: 1rem; }
  .footer-link { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--color-muted); text-decoration: none; }
  .footer-link[aria-current] { color: var(--color-ink); font-weight: 600; }
  .footer-link:hover { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; }
</style>
