---
import '../styles/global.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';

const SITE_NAME = 'Dateiwerkzeuge';

interface Props {
  /** Seitentitel ohne Sitename; ergibt „<title> – Dateiwerkzeuge“. */
  title: string;
  /** Meta-Beschreibung der Seite. */
  description: string;
  /** Seite von Suchmaschinen ausschließen (z. B. 404). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = `${title} – ${SITE_NAME}`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f4" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="no-referrer" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <SiteHeader siteName={SITE_NAME} />
    <main id="inhalt" tabindex="-1" class="flex-1 pb-16 pt-8 outline-none sm:pt-12">
      <noscript>
        <div class="page-container mb-8">
          <p class="notice notice-warn">
            JavaScript ist deaktiviert. Die Werkzeuge benötigen JavaScript, weil die Dateien direkt im
            Browser verarbeitet werden. Die Informationsseiten lassen sich auch ohne JavaScript lesen.
          </p>
        </div>
      </noscript>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
